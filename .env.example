# Firebase Configuration Settings
# Replace these placeholders with your actual credentials from the Firebase Console.
# Copy this file to '.env' locally, and add them as Environment Variables on the Vercel Dashboard!

# Firebase Frontend configuration variables
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id-here
FIREBASE_APP_ID=your-app-id-here
